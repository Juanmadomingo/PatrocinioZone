<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Patrocinio Zone</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🏟️ Patrocinio Zone</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Club" asp-action="Index">Clubes</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Patrocinador" asp-action="Index">Patrocinadores</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ZonaPatrocinio" asp-action="Index">Zonas</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="text-center mt-5 text-muted">
        <hr />
        <p>© 2025 - Patrocinio Zone App</p>
    </footer>
</body>
</html>
