@model PatrocinioZoneProyecto.Models.RegisterViewModel

<h2>Registro</h2>

<form asp-action="Register" method="post">
    <div>
        <label>Nombre:</label>
        <input asp-for="Nombre" />
    </div>
    <div>
        <label>Email:</label>
        <input asp-for="Email" />
    </div>
    <div>
        <label>Password:</label>
        <input asp-for="Password" type="password" />
    </div>
    <div>
        <label>Tipo de usuario:</label>
        <select asp-for="TipoUsuario">
            <option value="Club">Club</option>
            <option value="Patrocinador">Patrocinador</option>
        </select>
    </div>

    <!-- Si es Club, seleccionar deporte -->
    <div>
        <label>Deporte:</label>
        <select asp-for="Deporte">
            @foreach (var d in Enum.GetValues(typeof(PatrocinioZoneProyecto.Models.Enums.Deporte)))
            {
                <option value="@d">@d</option>
            }
        </select>
    </div>

    <div>
        <label>Monto (solo Patrocinador):</label>
        <input asp-for="Monto" type="number" step="0.01" />
    </div>

    <button type="submit">Registrarse</button>
</form>

<!-- Botón para ir a Login -->
<form asp-action="Login" method="get" style="margin-top:10px;">
    <button type="submit">Ya tienes cuenta? Inicia sesión aquí</button>
</form>
