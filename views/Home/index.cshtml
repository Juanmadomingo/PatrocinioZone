@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mt-5">
    <h1 class="display-4">Bienvenido a Patrocinio Zone</h1>
    <p class="lead">Conecta clubes y patrocinadores de todo el país</p>
    <div class="mt-4">
        <a class="btn btn-primary btn-lg mx-2" asp-controller="Club" asp-action="Index">Ver Clubes</a>
        <a class="btn btn-success btn-lg mx-2" asp-controller="Patrocinador" asp-action="Index">Ver Patrocinadores</a>
        <a class="btn btn-warning btn-lg mx-2" asp-controller="ZonaPatrocinio" asp-action="Index">Ver Zonas</a>
    </div>
</div>
