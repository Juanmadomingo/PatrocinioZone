@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-5 text-center">

    <h1 class="display-4">Patrocinio Zone</h1>
    <p class="lead">Sistema funcional de clubes, patrocinadores y zonas reales</p>

    <div class="mt-5">
        <a class="btn btn-primary btn-lg mx-2"
           asp-controller="Club" asp-action="Index">Ver Clubes</a>

        <a class="btn btn-success btn-lg mx-2"
           asp-controller="Patrocinador" asp-action="Index">Ver Patrocinadores</a>

        <a class="btn btn-warning btn-lg mx-2"
           asp-controller="ZonaPatrocinio" asp-action="Index">Ver Zonas</a>
    </div>
</div>
