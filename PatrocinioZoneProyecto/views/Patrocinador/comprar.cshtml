@model PatrocinioZoneProyecto.Models.ZonaPatrocinio

<h2>Comprar Zona</h2>

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card p-3">
    <h4>@Model.Nombre</h4>
    <p>@Model.Descripcion</p>
    <p><strong>Club:</strong> @Model.Club.Nombre</p>
    <p><strong>Precio:</strong> $@Model.Precio</p>

    @if (Model.PatrocinadorId == null)
    {
    <form asp-action="ComprarConfirmado" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-success">Confirmar compra</button>
    </form>
    }
    else
    {
    <span class="badge bg-danger">VENDIDA</span>
    }

    <a href="/Patrocinador/Index" class="btn btn-secondary mt-2">Volver</a>
</div>
