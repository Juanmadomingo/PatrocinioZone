@model IEnumerable<PatrocinioZoneProyecto.Models.Club>

    @{
    ViewData["Title"] = "Clubes";
    }

    <h2>Clubes registrados</h2>

    <p>
        <a class="btn btn-primary" asp-action="Create">+ Nuevo Club</a>
    </p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Deporte</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Email</td>
                <td>@item.Deporte.ToString()</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.Id">Ver</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
