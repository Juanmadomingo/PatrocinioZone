@model PatrocinioZoneProyecto.Models.Club

@{
    Layout = "_Layout";
}

<h2>Panel de Club</h2>

<p><strong>Club:</strong> @Model.Nombre</p>
<p><strong>Monto acumulado:</strong> $@Model.MontoBase</p>

<p>
    <a asp-controller="Club" asp-action="CreateZona" class="btn btn-primary">Crear zona patrocinio</a>
</p>

<h3>Mis patrocinios</h3>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Ubicación</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Comprador</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var z in Model.Zonas)
    {
        <tr>
            <td>@z.Nombre</td>
            <td>@z.Ubicacion</td>
            <td>$@z.Precio</td>
            <td>@(z.PatrocinadorId == null ? "En venta" : "Vendido")</td>
            <td>@(z.Patrocinador != null ? z.Patrocinador.Nombre : "-")</td>
            <td>
                @if (z.PatrocinadorId == null)
                {
                <form asp-controller="Club" asp-action="DeleteZona" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@z.Id" />
                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>