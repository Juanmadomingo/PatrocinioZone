<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PatrocinioZone</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
            <a class="navbar-brand" href="/">PatrocinioZone</a>

            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">

                    @if (Context.Session.GetString("UsuarioTipo") == "Club")
                    {
                    <li class="nav-item"><a class="nav-link" href="/Club/Index">Mis Zonas</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Club/CrearZona">Crear Zona</a></li>
                    }
                    else if (Context.Session.GetString("UsuarioTipo") == "Patrocinador")
                    {
                    <li class="nav-item"><a class="nav-link" href="/Patrocinador/Index">Ofertas Disponibles</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Patrocinador/MisCompras">Mis Compras</a></li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (string.IsNullOrEmpty(Context.Session.GetString("UsuarioId")))
                    {
                    <li class="nav-item"><a class="nav-link" href="/Account/Login">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Account/ChooseType">Registrarse</a></li>
                    }
                    else
                    {
                    <li class="nav-item"><span class="nav-link text-white">Hola, @Context.Session.GetString("UsuarioNombre")!</span></li>
                    <li class="nav-item"><a class="nav-link text-danger" href="/Account/Logout">Salir</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="text-center text-muted mt-5 mb-3">
        <p>© 2025 - PatrocinioZone</p>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
